{
  "manifest_version": 3,
  "name": "Task & Project Manager",
  "version": "6.0",
  "description": "Manage projects, tasks, weekly plans, notes and calendar",
  "action": {
    "default_title": "Open Dashboard",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}